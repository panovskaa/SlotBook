{
  "name": "@slotbook/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "perf": "nest build && ts-node -P tsconfig.test.json perf/slots-week.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@slotbook/shared": "0.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "luxon": "3.7.2",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "11.14.0",
    "@types/autocannon": "7.12.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.3",
    "autocannon": "8.0.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  }
}
