# Postgres started by `docker compose up -d`
DATABASE_URL=postgresql://slotbook:slotbook@localhost:5432/slotbook

# Shared secret the host sends in the X-Host-Key header. Use a long random value.
HOST_ACCESS_KEY=change-me-to-a-long-random-string

# The one time zone the app works in (IANA name)
APP_TIMEZONE=Europe/Berlin

# Origin of the frontend, for CORS
WEB_ORIGIN=http://localhost:5173

# API port
PORT=3000

# Optional: rate limit for booking, cancelling and joining the waitlist, per IP and endpoint
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: SMTP server for confirmation emails with the private cancellation link.
# smtp://localhost:1025 is Mailpit from docker-compose (inbox at http://localhost:8025).
# For real email use your provider, e.g. smtps://user:password@smtp.example.com:465. Empty = no emails.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SlotBook <no-reply@slotbook.local>

# Optional: Gemini API key for AI confirmation messages (free tier, https://aistudio.google.com/apikey).
# Leave empty to always use the built-in template message.
GEMINI_API_KEY=
# Optional: which free-tier model to use (default gemini-3.5-flash-lite)
GEMINI_MODEL=
